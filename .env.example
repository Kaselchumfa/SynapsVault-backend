# SynapsVault Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# The server validates these on boot (src/config.ts) and exits with a list of
# problems if anything required is missing or inconsistent.
#
# Every key below is parsed by src/config.ts. Entries are annotated:
#   [required] — must be set (or derivable) or boot fails
#   [optional] — has a default or may be left unset
# A test (test/config-env-example.test.ts) asserts this file stays in sync.

# ── Core ────────────────────────────────────────────────────────────────────
# [optional] development | production | test
NODE_ENV=development
# [optional] HTTP port
PORT=4021
# [optional] Proxy hop count; only trusted in production. Set TRUST_PROXY=1 on Railway.
# TRUST_PROXY=1
# [required] Public base URL of this service
BASE_URL=http://localhost:4021
# [required] Frontend origin; always allowed by CORS
WEB_APP_URL=http://localhost:5173
# [optional] CORS allowlist (comma-separated). WEB_APP_URL is always allowed.
# Entries may use a host wildcard, e.g. https://*.vercel.app for previews.
ALLOWED_ORIGINS=http://localhost:5173

# ── Stellar / x402 ──────────────────────────────────────────────────────────
# [optional] testnet | mainnet — selects defaults for NETWORK, SOROBAN_RPC_URL
# and USDC_CONTRACT_ID.
STELLAR_NETWORK=testnet
# [optional] CAIP-2 network id. Default: stellar:testnet (testnet) / stellar:pubnet (mainnet)
NETWORK=stellar:testnet
# [optional] Soroban RPC endpoint. Default: https://soroban-testnet.stellar.org (testnet)
# / https://soroban-rpc.mainnet.stellar.gateway.fm (mainnet)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# [optional] USDC Stellar asset contract id. Default: the testnet/mainnet USDC SAC.
USDC_CONTRACT_ID=
# [optional] x402 facilitator endpoint
FACILITATOR_URL=https://www.x402.org/facilitator
# [required] Platform wallet that receives verification fees
PAY_TO=
# [required] Platform agent secret key, S...
AGENT_SECRET_KEY=

# ── Soroban vault registry ──────────────────────────────────────────────────
# [required] Same contract under two names; setting either one is enough.
VAULT_REGISTRY_CONTRACT_ID=
REGISTRY_CONTRACT_ID=
# [required] Deployer / owner secret used for registry admin calls
REGISTRY_SECRET_KEY=

# ── AI verification ─────────────────────────────────────────────────────────
# [required] OpenRouter API key
OPENROUTER_API_KEY=
# [optional] Model used for verification
OPENROUTER_MODEL=anthropic/claude-sonnet-4
# [optional] Price charged per verification (USD)
VERIFICATION_PRICE=0.10
# [optional] Prompt token cost per 1M tokens (USD)
VERIFICATION_PROMPT_COST_PER_1M=3
# [optional] Completion token cost per 1M tokens (USD)
VERIFICATION_COMPLETION_COST_PER_1M=15

# ── Database ────────────────────────────────────────────────────────────────
# [required] Postgres connection string
DATABASE_URL=postgres://synapse:synapse@localhost:5432/synapsvault
# [optional] Pool tuning
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECT_TIMEOUT_MS=10000
# [optional] Per-statement timeout in ms (0 disables)
DB_STATEMENT_TIMEOUT_MS=30000

# ── Supabase storage ────────────────────────────────────────────────────────
# [required] Supabase project URL
SUPABASE_URL=https://your-project.supabase.co
# [required] Service key; SUPABASE_SERVICE_ROLE_KEY is accepted as an alias
SUPABASE_SERVICE_KEY=
# [optional] Storage bucket name
SUPABASE_STORAGE_BUCKET=resources

# ── Limits ──────────────────────────────────────────────────────────────────
# [optional] Max upload size in MB
MAX_FILE_SIZE_MB=50
# [optional] Max JSON body size (e.g. 1mb)
MAX_JSON_BODY_SIZE=1mb
# [optional] Comma-separated allowlist of upload MIME types
ALLOWED_UPLOAD_MIME_TYPES=image/png,image/jpeg,application/pdf
# [optional] Request timeout in ms
REQUEST_TIMEOUT_MS=30000
# [optional] Graceful shutdown timeout in ms
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000

# ── Rate limiting ───────────────────────────────────────────────────────────
# [optional] Shared store for multi-instance deployments (in-memory otherwise)
REDIS_URL=redis://localhost:6379
RATE_LIMIT_VERIFY_IP_MAX=10
RATE_LIMIT_VERIFY_IP_WINDOW_MS=60000
RATE_LIMIT_VERIFY_WALLET_MAX=5
RATE_LIMIT_VERIFY_WALLET_WINDOW_MS=3600000
RATE_LIMIT_PUBLISH_IP_MAX=20
RATE_LIMIT_PUBLISH_IP_WINDOW_MS=60000
RATE_LIMIT_PUBLISH_WALLET_MAX=10
RATE_LIMIT_PUBLISH_WALLET_WINDOW_MS=3600000
# Authenticated publisher routes; publishers can override within MAX_RPM
# via PATCH /publishers/me/rate-limit.
PUBLISHER_RATE_LIMIT_RPM_DEFAULT=60
PUBLISHER_RATE_LIMIT_MAX_RPM=10000
PUBLISHER_RATE_LIMIT_WINDOW_MS=60000

# ── Publisher webhooks ──────────────────────────────────────────────────────
# Publishers configure their own URL/secret via PATCH /publishers/me/webhooks.
# [optional] Webhook delivery tuning
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=3

# ── Request signing ─────────────────────────────────────────────────────────
# [optional] When true, publisher mutations need X-Timestamp + X-Signature
# (HMAC of the canonical request, keyed by the API key).
REQUIRE_REQUEST_SIGNATURE=false
SIGNATURE_MAX_SKEW_MS=300000

# ── Caching / idempotency ───────────────────────────────────────────────────
# [optional] Cache and idempotency tuning
IDEMPOTENCY_TTL_MS=86400000
CATALOG_CACHE_TTL_MS=10000
CATALOG_CACHE_MAX_KEYS=200

# ── Observability ───────────────────────────────────────────────────────────
# [optional] Bearer token for /metrics; the endpoint is disabled when unset.
METRICS_TOKEN=
# [optional] Sentry DSN for error reporting
SENTRY_DSN=
# [optional] OTEL exporter endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# [optional] OTEL service name
# OTEL_SERVICE_NAME=synapsvault-backend

# ── Background workers ──────────────────────────────────────────────────────
# The event listener and retry worker must run on a single instance. Either
# enable them on one replica only (WORKERS_ENABLED=false elsewhere), or leave
# WORKERS_ENABLED=true everywhere and let a Postgres advisory lock elect one
# leader. Disabling them on all replicas stops ledger indexing and retries.
WORKERS_ENABLED=true
# The ledger checkpoint is stored in Postgres (table ledger_checkpoints) so it
# survives container recreation. This file path is only a fallback used when
# the database is unreachable.
# [optional] Where the registry event listener checkpoints its last processed ledger
# LEDGER_TRACKER_PATH=./last-processed-ledger.json
